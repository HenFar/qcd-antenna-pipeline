In[1]:=",ExpressionUUID->"f81a6b41-a9c2-4554-86cf-d26b7702dfac"],

Cell[BoxData[
 FormBox[
  StyleBox["\<\"FeynCalc 10.2.1  \[CenterDot]  FeynArts 3.12 (27\
\[NonBreakingSpace]Mar\[NonBreakingSpace]2025)  \[CenterDot]  FeynHelpers \
2.0.0  \[CenterDot]  FeynCalcLegacy 1.0.0\"\>", "Text",
   StripOnInput->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.993543767125712*^9},
 CellLabel->
