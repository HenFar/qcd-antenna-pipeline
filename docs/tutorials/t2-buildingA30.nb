Cell["\<\
Building an antenna in AntCalc is remarkably simple. Simply run:\
\>", "Text",
 CellChangeTimes->{{3.993543778229184*^9, 
  3.993543804254158*^9}},ExpressionUUID->"094cae32-051c-4b8c-b7ff-\
334360de2e05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"A30unintegrated", " ", "=", " ", 
  RowBox[{"BuildAntenna", "[", 
   RowBox[{"A", ",", "3", ",", "0"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9935438055265093`*^9, 3.993543815428698*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"6a46aff9-b003-4e89-8129-1de53419e844"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"[\"\>", "\[InvisibleSpace]", "\<\"2026-07-20 14:43:36\"\>", 
    "\[InvisibleSpace]", "\<\"] \"\>", 
    "\[InvisibleSpace]", "\<\"BuildAntenna [\"\>", "\[InvisibleSpace]", "1", 
    "\[InvisibleSpace]", "\<\"/\"\>", "\[InvisibleSpace]", "5", 
    "\[InvisibleSpace]", "\<\"]: \"\>", 
    "\[InvisibleSpace]", "\<\"resolving route setup\"\>", 
    "\[InvisibleSpace]", "\<\" \"\>", 
    "\[InvisibleSpace]", "\<\"{A, 3, 0} with Component -> All, Contribution \
-> All\"\>"}],
   SequenceForm[
   "[", "2026-07-20 14:43:36", "] ", "BuildAntenna [", 1, "/", 5, "]: ", 
    "resolving route setup", " ", 
    "{A, 3, 0} with Component -> All, Contribution -> All"],
   Editable->False], TraditionalForm]], "Print",
