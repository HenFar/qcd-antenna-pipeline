Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", 
      TagBox["\[CurlyEpsilon]",
       TraditionalForm]}], "q2"]}], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["s12", "2"]}], 
    RowBox[{"q2", " ", "s13", " ", "s23"}]], "+", 
   FractionBox[
    RowBox[{"2", " ", "s12"}], 
    RowBox[{"q2", " ", "s13"}]], "+", 
   FractionBox[
    RowBox[{"2", " ", "s12"}], 
    RowBox[{"q2", " ", "s23"}]], "-", 
   FractionBox[
    RowBox[{
     TagBox["\[CurlyEpsilon]",
      TraditionalForm], " ", "s23"}], 
    RowBox[{"q2", " ", "s13"}]], "-", 
   FractionBox[
    RowBox[{
     TagBox["\[CurlyEpsilon]",
      TraditionalForm], " ", "s13"}], 
    RowBox[{"q2", " ", "s23"}]], "+", 
   FractionBox["s23", 
    RowBox[{"q2", " ", "s13"}]], "+", 
   FractionBox["s13", 
    RowBox[{"q2", " ", "s23"}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.993543816766417*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"a9e6d473-93c9-4a3f-9025-0558303c08d1"]
}, Open  ]],

Cell["\<\
This function builds the antennae specifically with the two hard original \
radiators as particles 1 and 2, that is, in this case A30(1q, 3g, 2bar q). In \
our notation, q2 denotes the centre of mass energy, which for this case makes \
q2 = s123 = s12 + s13 + s23. These antenna functions are most commonly shown \
as epsilon expansions, and that effect can be achieved here with:\
\>", "Text",
 CellChangeTimes->{{3.993543835107518*^9, 3.99354393505438*^9}, {
  3.993544021121086*^9, 
  3.9935440549044847`*^9}},ExpressionUUID->"a2f01957-58e8-45ae-9f1c-\
8175c128216e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"A30Epsilon", " ", "=", " ", 
  RowBox[{"A30unintegrated", "//", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", "Epsilon"}], "]"}], "&"}]}]}]], "Input",
 CellChangeTimes->{{3.993543936778315*^9, 3.993543977687101*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"b37ff6ac-2f23-492d-83e0-df77e247eb51"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["s12", "2"]}], 
    RowBox[{"q2", " ", "s13", " ", "s23"}]], "+", 
   FractionBox[
    RowBox[{"2", " ", "s12"}], 
    RowBox[{"q2", " ", "s13"}]], "+", 
   FractionBox[
    RowBox[{"2", " ", "s12"}], 
    RowBox[{"q2", " ", "s23"}]], "+", 
   RowBox[{
    TagBox["\[CurlyEpsilon]",
     TraditionalForm], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["s13", 
        RowBox[{"q2", " ", "s23"}]]}], "-", 
      FractionBox["s23", 
       RowBox[{"q2", " ", "s13"}]], "-", 
      FractionBox["2", "q2"]}], ")"}]}], "+", 
   FractionBox["s23", 
    RowBox[{"q2", " ", "s13"}]], "+", 
   FractionBox["s13", 
    RowBox[{"q2", " ", "s23"}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{{3.9935439487532253`*^9, 3.993543978273193*^9}},
 CellLabel->"Out[5]=",ExpressionUUID->"203f1d83-384e-4a54-bc94-fd50a88a4141"]
}, Open  ]],

Cell["\<\
