Cell["\<\
One of the two central functions in AntCalc is BuildAntenna. This function \
builds, from the Feynman diagrams, the unintegrated antenna functions. 

Start by launching AntCalc:\
\>", "Text",
 CellChangeTimes->{{3.993543673676487*^9, 
  3.9935437733213654`*^9}},ExpressionUUID->"bf60d082-e4d4-4270-add9-\
15a76e0328e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<<", "AntCalc`"}]], "Input",
 CellChangeTimes->{{3.993543756586331*^9, 3.9935437606031427`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a52004cd-5eb4-4357-b8ca-adcb33b88fbc"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    StyleBox["\<\"AntCalc \"\>", "Text",
     StripOnInput->False,
     FontWeight->Bold], "\[InvisibleSpace]", 
    StyleBox[
     TemplateBox[{"\"0.2.0\"", 
       StyleBox["\" \[Alpha] \"", "Text", StripOnInput -> False], "\"1\""},
      "RowDefault"], "Text",
     StripOnInput->False]}],
   SequenceForm[
    Style["AntCalc ", "Text", Bold], 
    Style[
     Row[{"0.2.0", 
       Style[" \[Alpha] ", "Text"], "1"}], "Text"]],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.993543767124919*^9},
 CellLabel->
