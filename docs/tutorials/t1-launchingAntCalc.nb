Notebook[{

Cell[CellGroupData[{
Cell["Loading AntCalc", "Title",
 CellChangeTimes->{{3.993472024885622*^9, 
  3.993472027355548*^9}},ExpressionUUID->"a4857368-696c-4ee1-bde2-\
6e237f36ea69"],

Cell["\<\
When the repository is first cloned, it must be installed to Mathematica as a \
Paclet. This is done using the following commands. 
*Do not forget to edit the code to your cloned repository folder*\
\>", "Text",
 CellChangeTimes->{{3.993472036149788*^9, 
  3.993472119738003*^9}},ExpressionUUID->"9e51eba0-010d-4717-8e42-\
d991238d64e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"repoRoot", "=", "\"\</path/to/antenna_pipeline\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"archive", "=", 
   RowBox[{"CreatePacletArchive", "[", 
    RowBox[{"repoRoot", ",", "$TemporaryDirectory"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PacletInstall", "[", "archive", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.993472142401326*^9, 3.993472142401532*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"ca898665-c7b4-414d-ba69-4caf5125430c"],

Cell["If you are reinstalling a changed development build, use:", "Text",
 CellChangeTimes->{{3.9934721614108667`*^9, 
  3.9934721832882833`*^9}},ExpressionUUID->"1a1c4a85-ec67-4c34-b5c4-\
a43293d2b5fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PacletInstall", "[", 
   RowBox[{"archive", ",", 
    RowBox[{"ForceVersionInstall", "->", "True"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PacletDataRebuild", "[", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.993472187529093*^9, 3.993472199709676*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"1cf35bbd-7d81-4dd8-b941-abc0c8de07bf"],

Cell["\<\
After this step you must restart the kernel.

To launch AntCalc we run the following line, which along with the package, it \
also loads FeynCalc and LiteRed2. These two other packages are necessary and \
mandatory for the correct functioning of AntCalc.\
\>", "Text",
 CellChangeTimes->{{3.993472203889986*^9, 
  3.99347229322644*^9}},ExpressionUUID->"d6b234d9-2f7a-4e2c-bd2f-\
790395248849"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"<<", "AntCalc`"}]], "Input",
 CellChangeTimes->{{3.993472295702351*^9, 3.9934722998099747`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"d8bf556d-49fa-40d2-ab55-35eb3721adb2"],

Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    StyleBox["\<\"AntCalc \"\>", "Text",
     StripOnInput->False,
     FontWeight->Bold], "\[InvisibleSpace]", 
    StyleBox[
     TemplateBox[{"\"0.2.0\"", 
       StyleBox["\" \[Alpha] \"", "Text", StripOnInput -> False], "\"1\""},
      "RowDefault"], "Text",
     StripOnInput->False]}],
   SequenceForm[
    Style["AntCalc ", "Text", Bold], 
    Style[
     Row[{"0.2.0", 
       Style[" \[Alpha] ", "Text"], "1"}], "Text"]],
   Editable->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.99354733006559*^9, 3.993807948265992*^9, 
  3.993808138760977*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"0c5e31d4-b047-46c9-9026-774c1d585e28"],

Cell[BoxData[
 FormBox[
  StyleBox["\<\"FeynCalc 10.2.1  \[CenterDot]  FeynArts 3.12 (27\
\[NonBreakingSpace]Mar\[NonBreakingSpace]2025)  \[CenterDot]  FeynHelpers \
2.0.0  \[CenterDot]  FeynCalcLegacy 1.0.0\"\>", "Text",
   StripOnInput->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.99354733006559*^9, 3.993807948265992*^9, 
  3.9938081387615843`*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"6cb232ce-1ea1-4e92-a7ac-d976432b490c"],

Cell[BoxData[
 FormBox[
  StyleBox["\<\"LiteRed2 2.025\[Beta]\"\>", "Text",
   StripOnInput->False], TraditionalForm]], "Print",
 CellChangeTimes->{3.99354733006559*^9, 3.993807948265992*^9, 
  3.99380813876199*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"85f1b016-880d-4287-b66e-2629b37ea608"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
