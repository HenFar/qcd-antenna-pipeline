Cell["\<\
To integrate an antenna in AntCalc we must first build it. The default output \
of the BuildAntenna function was chosen to be as close to what a user might \
want it to look like and not for compatibility. As such, the IntegrableForm \
option has to be used so that the entire backend structure is transferred to \
IntegrateAntenna. This can be all quickly run as\
\>", "Text",
 CellChangeTimes->{{3.993546088818194*^9, 
  3.993546194809951*^9}},ExpressionUUID->"9c565794-8225-4792-802b-\
bbfc46683984"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A30unint", "=", 
   RowBox[{"BuildAntenna", "[", 
    RowBox[{"A", ",", "3", ",", "0", ",", 
     RowBox[{"IntegrableForm", "->", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"A30int", "=", 
  RowBox[{"IntegrateAntenna", "[", "A30unint", "]"}]}]}], "Input",
 CellChangeTimes->{{3.993546197062064*^9, 3.993546221543456*^9}, {
  3.993546335947509*^9, 3.993546344550538*^9}, {3.993546394504467*^9, 
