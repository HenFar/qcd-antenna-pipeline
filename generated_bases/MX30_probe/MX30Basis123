    Declare[p1, Vector]], Hold[VecQ[p2], Declare[p2, Vector]], 
   Hold[VecQ[q], Declare[q, Vector]], 
   Hold[LiteRed`Private`ExpresionType[q] === LiteRed`Private`ExpresionType[
